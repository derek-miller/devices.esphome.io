---
/**
 * Device list for the /type, /board, /standards and /made-for-esphome pages.
 *
 * The listing itself is DeviceBrowser, scoped to the devices this page is
 * about, so every one of those pages gets search, facets and thumbnails
 * without knowing anything about them.
 */
import DeviceBrowser from "./DeviceBrowser.astro";
import type { DeviceEntry } from "../utils/getDevices";

interface Props {
  devices: DeviceEntry[];
  emptyMessage?: string;
}

const { devices, emptyMessage = "No devices found." } = Astro.props;
---

<DeviceBrowser
  scopeIds={devices.map((device) => device.id)}
  emptyMessage={emptyMessage}
/>
